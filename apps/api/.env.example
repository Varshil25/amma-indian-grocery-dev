# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="your-access-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Stripe (optional) — card payments are offered at checkout only when the secret AND
# publishable keys are set. Leave blank to take pay-on-delivery / pay-at-pickup orders only.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Square POS (optional)
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
SQUARE_ENVIRONMENT="sandbox"
# Signature key from the Square webhook subscription; webhooks are rejected without it
SQUARE_WEBHOOK_SIGNATURE_KEY=""

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Email (SendGrid)
SENDGRID_API_KEY="your_sendgrid_key"
EMAIL_FROM="noreply@ammagrocery.com"

# Server
PORT=8000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
# Optional public URL of this API, used in links to uploaded images (defaults to the request host)
# API_PUBLIC_URL="https://amma-grocery-api.onrender.com"

# First admin account — only read by `npm run db:seed` (password: 10+ characters)
# ADMIN_EMAIL="owner@yourstore.com"
# ADMIN_PASSWORD=""
